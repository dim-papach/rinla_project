{
  "simulate": {
    "cosmic_fraction": 0.01,
    "cosmic_value": null,
    "cosmic_seed": null,
    "trails": 1,
    "trail_width": 3,
    "min_angle": -45.0,
    "max_angle": 45.0,
    "trail_value": null,
    "output_dir": "./output"
  },
  "process": {
    "shape": "none",
    "mesh_cutoff": null,
    "tolerance": 0.0001,
    "restart": 0,
    "scaling": 1,
    "nonstationary": 1,
    "output_dir": "./processed",
    "mesh_resolution": 30,
    "max_edge_factor": 10.0,
    "outer_edge_factor": 1.5,
    "offset_inner_factor": 0.5,
    "offset_outer_factor": 2.0,
    "alpha": 2,
    "prior_range_prob": 0.2,
    "prior_range_lower": 2.0,
    "prior_sigma_prob": 0.2,
    "prior_sigma_upper": 2.0,
    "num_threads": 6,
    "openmp_strategy": "huge",
    "nbasis": 2,
    "spline_degree": 10
  },
  "validate": {
    "metrics": [
      "ssim",
      "mse",
      "mae"
    ],
    "generate_plots": true,
    "output_dir": "./validation"
  },
  "plot": {
    "plot_type": "all",
    "dpi": 150,
    "cmap": "viridis",
    "residual_cmap": "viridis",
    "percentile_min": 1,
    "percentile_max": 99,
    "residual_percentile_min": 1,
    "residual_percentile_max": 99,
    "output_dir": "./plots"
  }
}